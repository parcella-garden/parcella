# Optional. The published docker-compose.yml runs without any .env file
# (ADR 0121). Copy this to .env and uncomment only what you want to change.

# Image version (published to GHCR). Defaults to "latest"; pin a release
# (e.g. "6.4.0") for a reproducible deploy.
#PARCELLA_VERSION=latest

# Database. The database isn't reachable from outside the compose network,
# but a non-default password doesn't hurt. Set it BEFORE the first start:
# Postgres only applies it when it initializes an empty data folder.
#POSTGRES_DB=parcella
#POSTGRES_USER=parcella
#POSTGRES_PASSWORD=changeme

# Left empty, a random key is generated on first start into
# ./data/secrets/secret_key. Set one only to manage it yourself, e.g.:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it later logs everyone out and makes stored passwords unreadable.
#SECRET_KEY=

# "production" by default in docker-compose.yml (HTTPS-only cookies, HSTS).
# docker-compose.dev.yml defaults to "development".
#ENVIRONMENT=production

# Email is configured in the admin panel and stored in the database. These
# are only a fallback for installs that never set it there.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=user@example.com
#SMTP_PASSWORD=
#SMTP_FROM=club@example.com
#SMTP_TLS=true

# Development only (docker-compose.dev.yml builds the image): match the
# container user to yours so files it creates in mounted folders aren't
# owned by root. Find them with "id -u" / "id -g".
#UID=1000
#GID=1000
