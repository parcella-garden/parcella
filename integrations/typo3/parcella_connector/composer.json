{
    "name": "parcella/typo3-parcella-connector",
    "description": "Receives website drafts from Parcella, the club management software for allotment garden associations, as hidden news records.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/parcella-garden/parcella/tree/main/integrations/typo3/parcella_connector",
    "support": {
        "issues": "https://github.com/parcella-garden/parcella/issues"
    },
    "require": {
        "php": ">=8.1",
        "typo3/cms-core": "^12.4 || ^13.4",
        "typo3/cms-frontend": "^12.4 || ^13.4",
        "georgringer/news": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Parcella\\ParcellaConnector\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "parcella_connector"
        }
    }
}
